{
  "ConnectionStrings": {
    "Cs2Prices": "Server=localhost,1433;Database=Cs2Prices;User Id=sa;Password=Cs2Prices_Dev#2026;TrustServerCertificate=True;Encrypt=True"
  },
  "Providers": {
    "Skinport": {
      "Enabled": true,
      "PollInterval": "00:05:00",
      "Currency": "EUR"
    },
    "Steam": {
      "Enabled": true,
      "SweepEnabled": true,
      "SweepInterval": "01:00:00",
      "OrderBookEnabled": true,
      "OrderBookInterval": "00:05:00",
      "MaxWatchlistPerCycle": 40,
